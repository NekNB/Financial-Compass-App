<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Кнопка i в левом верхнем углу -->
    <Button
        android:id="@+id/btnInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="#2C5F70"
        android:text="@string/Info"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Панель с датой и балансом -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="60dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/_35_000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Событие по центру -->
    <TextView
        android:id="@+id/tvEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topPanel"
        android:layout_marginTop="32dp"
        android:text="@string/event"
        android:textSize="20sp"
        android:gravity="center"
        android:padding="24dp"
        android:minHeight="150dp"
        android:background="@android:drawable/editbox_background" />

    <!-- Контейнер для кнопок действий -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvEvent"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:gravity="center" />

    <!-- Комментарий -->
    <TextView
        android:id="@+id/tvComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonsContainer"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:text=""
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        android:background="#F0F0F0" />

    <!-- Кнопка следующая трата -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvComment"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:enabled="false"
        android:padding="12dp"
        android:text="@string/NextAction"
        android:textSize="20sp" />

</RelativeLayout>