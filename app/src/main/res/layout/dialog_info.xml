<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <!-- Заголовок с иконкой -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Вводные данные"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2196F3" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#2196F3"
        android:layout_marginBottom="16dp" />

    <!-- Доход -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰 ДОХОД ЗА МЕСЯЦ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="35 000 ₽"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Стипендия: 6 000 ₽\n• Подработка: 23 000 ₽\n• Помощь от семьи: 6 000 ₽"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginBottom="16dp" />

    <!-- Обязательные траты -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ ОБЯЗАТЕЛЬНЫЕ ТРАТЫ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF9800"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5-е число: аренда комнаты – 10 000 ₽\n10-е число: проездной – 1 500 ₽\n15-е число: связь и интернет – 1 000 ₽\nКаждое воскресенье: еда – 2 000 ₽"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Итого: 20 500 ₽"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FF9800"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD"
        android:layout_marginVertical="8dp" />

    <!-- Остаток и цель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F0F8FF"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Остаток"
                android:textSize="12sp"
                android:textColor="#666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="14 500 ₽"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2196F3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цель"
                android:textSize="12sp"
                android:textColor="#666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Отложить 3 000 ₽"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>